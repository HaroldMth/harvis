# HARVIS configuration. Copy to .env and fill in what you use.
# You can also keep keys in ~/.tokens (same format); it overrides .env.

# --- Telegram interface ------------------------------------------------------
# Create a bot with @BotFather and paste the token.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot (ask @userinfobot).
# Leave empty and nobody can send HARVIS proactive messages.
TELEGRAM_ALLOWED_USERS=

# --- Persona -----------------------------------------------------------------
# What the assistant calls you in prompts and replies.
HARVIS_USER_NAME=User

# --- LLM providers (set at least one) ----------------------------------------
# NOTE: the provider layer is being reworked; these names may change.
GROQ=
GEMINI=
POLLINATIONS=
MISTRAL=
OMNIROUTE=
CEREBRAS=
COHERE=
OPENROUTER=
OPUS_PROXY=
# Optional. Normally auto-discovered from ~/.config/autopilot/config.json.
DIRECTIONALLY_LOCAL_API_KEY=

# --- Gmail plugin (optional) -------------------------------------------------
# Use a Google "App Password", not your account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Web search (optional) ---------------------------------------------------
# Self-hosted SearXNG instance used by the web search tool.
SEARXNG_URL=http://localhost:8080

# --- Safety switches (1 = on). Read the README before enabling. --------------
# Run shell commands without asking for confirmation.
HARVIS_AUTO_APPROVE=0
# Skip the command safety filter in Telegram shell mode.
HARVIS_SHELL_UNRESTRICTED=0
